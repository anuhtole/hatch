# ── Database (SQLite via libSQL) ─────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── Anthropic Claude (chat agent, résumé pipeline, memory extraction) ────────
ANTHROPIC_API_KEY=

# ── OpenAI — used ONLY for text-embedding-3-small (knowledge-base RAG) ───────
# Optional: without it, indexing still runs but semantic search is skipped.
OPENAI_API_KEY=

# ── Google OAuth2 (Gmail, Calendar, Drive) ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ── Canvas LMS ───────────────────────────────────────────────────────────────
CANVAS_BASE_URL=https://bcourses.berkeley.edu
CANVAS_API_TOKEN=
# Hide assignments created before this ISO timestamp ("now" = only new ones)
ASSIGNMENT_CUTOFF_TIMESTAMP=

# ── Second brain ─────────────────────────────────────────────────────────────
# Obsidian vault root. The agent reads/writes Markdown here (writes are gated
# behind user approval). Defaults to ~/vault.
VAULT_PATH=

# ── Résumé pipeline letterhead fallback ──────────────────────────────────────
# Used only when the vault has no sections/contact.md. Pipe-separated.
RESUME_NAME=
RESUME_CONTACT="City, ST | (000) 000-0000 | you@example.com | linkedin.com/in/you"

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
